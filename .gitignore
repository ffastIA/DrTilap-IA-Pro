# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments (MUITO IMPORTANTE)
env/
venv/
.env
.venv/
xxx.env
*.env

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE specific settings (Opcional, mas recomendado)
.vscode/
.idea/

# IDE specific settings (Opcional, mas recomendado)
.pdf
.docx

# Claude Code — configurações locais com credenciais (nunca commitar)
.claude/settings.local.json

# Segurança extra: ignorar qualquer settings.json dentro de .claude que contenha credenciais reais
# O settings.json commitado só deve ter placeholders (sem senhas ou tokens)
